#!/bin/sh

# Save config and data under the KOReader runtime directory
config_dir="settings/syncthing"
mkdir -p "$config_dir"
cacert="plugins/syncthing.koplugin/cacert.pem"
pid_file="/tmp/syncthing_koreader.pid"
startup_log="$config_dir/startup.log"

exec >> "$startup_log" 2>&1
echo "=== Starting Syncthing at $(date) ==="

home_dir="${1:-/}"
# Default ports: Web GUI 8384, Sync Engine 22000
port="${2:-8384}"
password="$3"

# Enforce default GUI port 8384 if empty or mistakenly set to sync port 22000
if [ "$port" = "22000" ] || [ -z "$port" ]; then
    port="8384"
fi

case "$port" in
    ''|*[!0-9]*)
        echo "Invalid Syncthing port: $port, falling back to default 8384" >&2
        port="8384"
        ;;
esac

# Stage binary to tmpfs (/var/tmp) to bypass FAT32 noexec/permissions limitations on Kindle
TMP_DIR="/var/tmp/syncthing-koreader"
mkdir -p "$TMP_DIR"
SRC_BIN="plugins/syncthing.koplugin/syncthing"

if [ ! -f "$SRC_BIN" ]; then
    echo "ERROR: Syncthing binary not found at $SRC_BIN" >&2
    exit 1
fi

RUN_BIN="$TMP_DIR/syncthing"
if [ ! -x "$RUN_BIN" ] || [ "$SRC_BIN" -nt "$RUN_BIN" ]; then
    echo "Staging syncthing binary to $RUN_BIN..."
    cp "$SRC_BIN" "$RUN_BIN"
    chmod +x "$RUN_BIN"
fi

# Store SQLite database on native ext4 filesystem (/var/local) to avoid FAT32 locking/corruption errors
data_dir="/var/local/syncthing-data"
if [ ! -d "/var/local" ] || [ ! -w "/var/local" ]; then
    data_dir="$config_dir"
else
    mkdir -p "$data_dir"
fi

if [ ! -f "$config_dir/config.xml" ] || [ -n "$password" ]; then
    echo "Generating Syncthing configuration..."
    HOME="$home_dir" SSL_CERT_FILE="$cacert" "$RUN_BIN" generate \
        --data="$data_dir" \
        --config="$config_dir" \
        --gui-user=syncthing \
        ${password:+--gui-password="$password"} \
        --no-port-probing 2>> "$startup_log" || true
fi

# Save the device ID to a file for easy access from KOReader
HOME="$home_dir" SSL_CERT_FILE="$cacert" "$RUN_BIN" device-id \
    --config="$config_dir" \
    --data="$data_dir" > "$config_dir/device-id" 2>> "$startup_log" || true

echo "Launching Syncthing daemon on port $port..."
HOME="$home_dir" SSL_CERT_FILE="$cacert" "$RUN_BIN" serve \
    --config="$config_dir" \
    --data="$data_dir" \
    --gui-address="http://0.0.0.0:$port" \
    --no-upgrade \
    --logfile="$config_dir/logs" \
    --log-max-old-files=10 \
    --log-max-size=1048576 &

echo $! > "$pid_file"
echo "Syncthing started with PID $(cat "$pid_file")"